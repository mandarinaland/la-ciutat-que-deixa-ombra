# ─────────────────────────────────────────────────────────────
# La ciutat que deixa ombra — variables d'entorn
# Copia aquest fitxer a .env.local per treballar en local.
# A Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública del lloc (sense barra final).
# Local: http://localhost:3000 · Producció: https://el-teu-domini.cat
# A Vercel Preview es pot deixar buida: s'utilitza VERCEL_URL automàticament.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clau pública (anon / publishable). Pot arribar al navegador: la protegeix RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clau secreta (service_role / secret). NOMÉS servidor.
# Mai amb prefix NEXT_PUBLIC_. Mai al repositori. A Vercel, marca-la com a "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=

# Slug de l'obra que s'obre a / i /auca
NEXT_PUBLIC_DEFAULT_WORK_SLUG=la-ciutat-que-deixa-ombra

# Secret per a /api/revalidate (webhooks o manteniment). Genera'l amb:  openssl rand -hex 32
REVALIDATE_SECRET=

# (Opcional, futur) Cloudflare Stream: codi de client per construir URLs HLS.
# NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
